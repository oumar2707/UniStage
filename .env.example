# Copier ce fichier en .env et renseigner les valeurs

# dev | prod | prod,demo
SPRING_PROFILES_ACTIVE=dev

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/unistage
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 32 caractères minimum (ex. : openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:4200

# PORT=8080

# Compte administrateur initial (hors profil dev)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comptes de démonstration (profil demo)
# DEMO_ADMIN_PASSWORD=
# DEMO_ETUDIANT_PASSWORD=
# DEMO_ENTREPRISE_PASSWORD=
